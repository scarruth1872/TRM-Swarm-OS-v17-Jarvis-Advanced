FROM ubuntu:22.04

# Avoid prompts during installation
ENV DEBIAN_FRONTEND=noninteractive

# Install core build dependencies
RUN apt-get update && apt-get install -y \
    git \
    cmake \
    python3 \
    python3-pip \
    python3-venv \
    build-essential \
    wget \
    curl \
    gnupg \
    lsb-release \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

# Install LLVM / Clang 18
RUN wget https://apt.llvm.org/llvm.sh && \
    chmod +x llvm.sh && \
    ./llvm.sh 18 && \
    apt-get install -y clang-18 clang++-18 && \
    rm llvm.sh

# Create system symlinks for clang and clang++ so setup_env.py uses Clang 18
RUN ln -sf /usr/bin/clang-18 /usr/bin/clang && \
    ln -sf /usr/bin/clang++-18 /usr/bin/clang++

# Set environment variables to use Clang-18 as the default compiler
ENV CC=clang-18
ENV CXX=clang++-18

WORKDIR /app

# Clone BitNet recursively to fetch submodules
RUN git clone --recursive --depth 1 https://github.com/microsoft/BitNet.git

WORKDIR /app/BitNet

# Copy and run the patch script to print compilation failure logs to stderr
COPY patch_setup_env.py /app/BitNet/patch_setup_env.py
RUN python3 patch_setup_env.py

# Set up Python environment and requirements
RUN python3 -m venv venv && \
    . venv/bin/activate && \
    pip install --no-cache-dir -r requirements.txt

# Create dummy model directories and a placeholder GGUF model to bypass download/conversion during build
RUN mkdir -p models/BitNet-b1.58-2B-4T && \
    echo "placeholder" > models/BitNet-b1.58-2B-4T/ggml-model-i2_s.gguf

# Run setup_env.py to perform codegen for BitNet-b1.58-2B-4T and compile llama-server
RUN . venv/bin/activate && \
    python3 setup_env.py -md models/BitNet-b1.58-2B-4T -q i2_s

# Copy the entrypoint script
COPY entrypoint_bitnet.sh /app/BitNet/entrypoint_bitnet.sh
RUN chmod +x /app/BitNet/entrypoint_bitnet.sh

# Expose API server port
EXPOSE 8580

# Run entrypoint
ENTRYPOINT ["/app/BitNet/entrypoint_bitnet.sh"]
