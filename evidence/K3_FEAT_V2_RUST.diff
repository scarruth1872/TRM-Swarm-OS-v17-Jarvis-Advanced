+// ───────────────────────────── featuriser v2 ─────────────────────────────
+// Fixes the two measured v1 defects (evidence/K3_GATE_DIAGNOSIS_MEASURED.json):
+//   D1 all trigrams were emitted before any 4/5-gram, so past ~190 characters
+//      the 4/5-grams never existed and the tail was dropped;
+//   D2 the EmbeddingBag mean divided by the padded width 192.
+// v2 gives each n-gram length a fair quota, keeps head AND tail of each length,
+// adds a directed word-pair channel so a negation can sit next to its verb, and
+// reports the real gram count so the pooling divisor is the real count.
+//
+// Every function here mirrors scratch/k3_feat_v2.py exactly. Bucket 0 is
+// reserved for padding: real ids are crc32 % (buckets - 1) + 1.
+
+/// Lowercase alphanumeric word split, same rule as v1's `char_ngram_ids`.
+fn words_of(text: &str) -> Vec<String> {
+    let lower = text.to_lowercase();
+    let mut words: Vec<String> = Vec::new();
+    let mut cur = String::new();
+    for ch in lower.chars() {
+        if ch.is_alphanumeric() {
+            cur.push(ch);
+        } else if !cur.is_empty() {
+            words.push(core::mem::take(&mut cur));
+        }
+    }
+    if !cur.is_empty() {
+        words.push(cur);
+    }
+    words
+}
+
+fn padded_string(words: &[String]) -> String {
+    if words.is_empty() {
+        return String::from("<>");
+    }
+    let mut s = String::from("<");
+    for (i, w) in words.iter().enumerate() {
+        if i > 0 {
+            s.push_str("><");
+        }
+        s.push_str(w);
+    }
+    s.push('>');
+    s
+}
+
+/// Real bucket for a gram: 1..=buckets-1, never 0 (0 is the padding id).
+#[inline]
+fn crc_id(s: &str, buckets: usize) -> usize {
+    (crc32(s.as_bytes()) as usize) % (buckets - 1) + 1
+}
+
+/// All length-n grams in order, skipping boundary-only grams.
+fn grams_for_len(padded: &[char], n: usize, buckets: usize, out: &mut Vec<usize>) {
+    if padded.len() < n {
+        return;
+    }
+    let mut buf = String::with_capacity(n);
+    for i in 0..=(padded.len() - n) {
+        let g = &padded[i..i + n];
+        if g.iter().all(|c| *c == '<' || *c == '>') {
+            continue;
+        }
+        buf.clear();
+        for c in g {
+            buf.push(*c);
+        }
+        out.push(crc_id(&buf, buckets));
+    }
+}
+
+/// Equal base quota per length (192/3 = 64), leftover slots redistributed
+/// round-robin to 5-, then 4-, then 3-grams. Deterministic: no RNG, so the
+/// kernel reproduces the trainer bit-for-bit.
+fn quotas(avail: [usize; 3], cap: usize) -> [usize; 3] {
+    let base = cap / 3;
+    let mut q = [avail[0].min(base), avail[1].min(base), avail[2].min(base)];
+    let mut left = cap - (q[0] + q[1] + q[2]);
+    let order = [2usize, 1, 0]; // index 0..2 == length 3..5
+    while left > 0 {
+        let mut progressed = false;
+        for &n in order.iter() {
+            if left > 0 && q[n] < avail[n] {
+                q[n] += 1;
+                left -= 1;
+                progressed = true;
+            }
+        }
+        if !progressed {
+            break;
+        }
+    }
+    q
+}
+
+/// k items: ceil(k/2) from the head, the rest from the tail. k <= seq.len() is
+/// guaranteed by the quota, so the two halves never overlap.
+fn take_head_tail(seq: &[usize], k: usize) -> Vec<usize> {
+    if k == 0 {
+        return Vec::new();
+    }
+    let h = (k + 1) / 2;
+    let t = k - h;
+    let mut out: Vec<usize> = seq[..h].to_vec();
+    if t > 0 {
+        out.extend_from_slice(&seq[seq.len() - t..]);
+    }
+    out
+}
+
+/// v2 ids. Returns (fixed-length ids padded with 0, number of REAL ids).
+/// `count` is a prefix length: ids[0..count] are real, the rest are padding.
+pub fn char_ngram_ids_v2(text: &str, buckets: usize) -> (Vec<usize>, usize) {
+    let words = words_of(text);
+    let padded_s = padded_string(&words);
+    let padded: Vec<char> = padded_s.chars().collect();
+
+    let mut per_len: [Vec<usize>; 3] = [Vec::new(), Vec::new(), Vec::new()];
+    for (k, n) in (3..=5usize).enumerate() {
+        grams_for_len(&padded, n, buckets, &mut per_len[k]);
+    }
+    let avail = [per_len[0].len(), per_len[1].len(), per_len[2].len()];
+    let q = quotas(avail, CHAR_CAP);
+
+    let mut ids: Vec<usize> = Vec::with_capacity(EMB_CAP_V2);
+    for k in 0..3 {
+        ids.extend(take_head_tail(&per_len[k], q[k]));
+    }
+
+    // Order channel: directed word pairs at distance 1 and 2.
+    let per_d = PAIR_CAP / 2;
+    for d in 1..=2usize {
+        let mut pairs: Vec<usize> = Vec::new();
+        if words.len() > d {
+            for i in 0..(words.len() - d) {
+                let key = alloc::format!("{}|{}|{}", words[i], d, words[i + d]);
+                pairs.push(crc_id(&key, buckets));
+            }
+        }
+        let k = per_d.min(pairs.len());
+        ids.extend(take_head_tail(&pairs, k));
+    }
+
+    ids.truncate(EMB_CAP_V2);
+    let count = ids.len();
+    ids.resize(EMB_CAP_V2, 0);
+    (ids, count)
+}
