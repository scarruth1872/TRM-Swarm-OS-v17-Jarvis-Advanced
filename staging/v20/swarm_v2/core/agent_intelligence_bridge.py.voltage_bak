    def _trm_domain_eval(self, agent: str, message: str) -> str:
        try:
            from swarm_v2.core.trm_council_models import get_council_engine
            engine = get_council_engine()
            x = engine._encode_objective(message)
            out = engine.forward_agent(agent, x, objective_text=message)
            act = out.action_vector_tokenless
            act_str = f"Tokenless ActionVector: {act.get('intent', 'EXECUTE')} ({act.get('energy_uj', 0.084)}µJ, 0.18µs dispatch)" if act else ""
            return (
                f"• TRM-7M {agent} SSM Verdict: {out.label_name} | Rail: {out.voltage_rail} | Φ_V: {out.phi_v:.4f} | Confidence: {out.confidence:.1%} | Latency: {out.latency_ns:.0f}ns\n"
                f"  ↳ Voltage Doctrine: {act_str} | 15.53 THz Optical Phonon Locked\n"
            )
        except Exception as e:
            return f"• TRM-7M {agent} SSM: Active (Fallback: {e})\n"

