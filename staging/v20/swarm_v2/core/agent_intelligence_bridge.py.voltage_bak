    def _respond(self, agent, response, engine, t0):
        return {
            "role": agent,
            "name": agent,
            "response": response,
            "status": "ok",
            "engine": engine,
            "latency_us": round((time.perf_counter() - t0) * 1e6, 1),
            "session": self._session,
            "msg_count": self._msg_count,
        }


