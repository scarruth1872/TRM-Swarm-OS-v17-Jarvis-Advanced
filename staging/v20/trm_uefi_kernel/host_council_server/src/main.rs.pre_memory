                    "active_threads", "l3_sram_kb", "host_clock_mhz", "host_mem_pct",
                    "total_vram_gb", "used_vram_gb", "gpu_util_pct"
                ],
                "read_from_scan_artifact": [
                    "real_modules_count", "fabricated_modules_count", "modules_compiled",
