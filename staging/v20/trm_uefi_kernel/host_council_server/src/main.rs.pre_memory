        let vram = host_probe::gpu_vram();
        response_json = json!({
            "kernel_version": "v20.0.0-sovereign",
            "runtime_type": "Native Rust no_std + host socket",
            "voltage_phi_v": phi,
            "voltage_phi_v_basis": phi_basis,
