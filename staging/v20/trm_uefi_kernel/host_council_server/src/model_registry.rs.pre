//! Model registry — makes ingested ternary models discoverable from the kernel.
//!
//! Reads `swarm_v2_artifacts/ternary_models/model_manifest.json` (written by
//! swarm_v2_artifacts/ingest_model_ternary.py) and serves it over:
//!
//!   GET /models            -> the manifest (model list + sizes + fidelity)
//!   GET /models/{name}     -> one model, with its bundle integrity re-verified
//!
//! Bundle integrity uses the platform's existing MMapHeader convention
//! (persistent_mmap_allocator): a 60-byte header, struct.pack('<QIIdII28s'),
//! carrying crc32 over bytes [0..28) at offset 28 — zlib-identical, so the
//! Python writer and this reader agree without any shared library.

use serde_json::{json, Value};
use std::fs;
use std::path::PathBuf;
use tiny_http::{Header, Method, Request, Response};

/// magic for the bundle header (`0x54524D01` = "TRM\x01" little-endian).
const MMAP_MAGIC: u64 = 0x5452_4D01;
const MMAP_VERSION: u32 = 1;
const HEADER_SIZE: usize = 60;
const CRC_PAYLOAD_LEN: usize = 28;
const CRC_OFFSET: usize = 28;

/// CRC-32 (IEEE 802.3 / zlib): reflected, init 0xFFFFFFFF, final XOR.
/// The platform's strip documents the same parameters, so values match Python's
/// zlib.crc32 exactly.
pub fn crc32(data: &[u8]) -> u32 {
    let mut crc: u32 = 0xFFFF_FFFF;
    for &b in data {
        crc ^= b as u32;
        for _ in 0..8 {
            let mask = (crc & 1).wrapping_neg();
            crc = (crc >> 1) ^ (0xEDB8_8320 & mask);
        }
    }
    !crc
}

/// Repo root, reusing kanban_handlers' resolution so all handlers agree.
fn repo_root() -> PathBuf {
    crate::kanban_handlers::repo_root()
}

/// Directory holding ingested bundles + the manifest.
pub fn models_dir() -> PathBuf {
    repo_root()
        .join("swarm_v2_artifacts")
        .join("ternary_models")
}

/// Live count of ingested models from the manifest (0 when the manifest is
/// absent/unreadable). Used by platform-introspection answers so "what are
/// your capabilities" reports the real registry, not a hardcoded number.
pub fn live_model_count() -> usize {
    load_manifest()
        .and_then(|v| {
            v.get("models")
                .and_then(|m| m.as_array())
                .map(|a| a.len())
        })
        .unwrap_or(0)
}

fn manifest_path() -> PathBuf {
    models_dir().join("model_manifest.json")
}

fn bundle_path(bundle: &str) -> PathBuf {
    manifest_path().with_file_name(bundle)
}

fn load_manifest() -> Option<Value> {
    let raw = fs::read_to_string(manifest_path()).ok()?;
    serde_json::from_str::<Value>(&raw).ok()
}

/// Verify a bundle's 60-byte header CRC. Returns (status, detail).
/// Mirrors native_mmap_verify_crc: legacy crc==0 is accepted as "legacy".
fn verify_bundle(bundle: &str) -> (&'static str, String) {
    let path = bundle_path(bundle);
    let raw = match fs::read(&path) {
        Ok(r) => r,
        Err(e) => return ("missing", format!("cannot read bundle: {e}")),
    };
    if raw.len() < HEADER_SIZE {
        return ("invalid", format!("header short: {} bytes", raw.len()));
    }
    let magic = u64::from_le_bytes(raw[0..8].try_into().unwrap());
    let version = u32::from_le_bytes(raw[8..12].try_into().unwrap());
    if magic != MMAP_MAGIC {
        return ("invalid", format!("bad magic {magic:#x}"));
    }
    if version != MMAP_VERSION {
        return ("invalid", format!("unsupported version {version}"));
    }
    let stored = u32::from_le_bytes(raw[CRC_OFFSET..CRC_OFFSET + 4].try_into().unwrap());
    let recomputed = crc32(&raw[..CRC_PAYLOAD_LEN]);
    if stored == 0 {
        ("legacy", "no CRC stored (pre-integrity bundle)".to_string())
    } else if stored == recomputed {
        (
            "intact",
            format!("crc32 {stored:#010x} verified over bytes [0..28)"),
        )
    } else {
        (
            "corrupt",
            format!("stored {stored:#010x} != recomputed {recomputed:#010x}"),
        )
    }
}

fn models_payload() -> Value {
    match load_manifest() {
        Some(v) => {
            let models = v
                .get("models")
                .and_then(|m| m.as_array())
                .cloned()
                .unwrap_or_default();
            let enriched: Vec<Value> = models
                .into_iter()
                .map(|m| {
                    let bundle = m.get("bundle").and_then(|b| b.as_str()).unwrap_or("");
                    let (status, detail) = verify_bundle(bundle);
                    let mut obj = m.as_object().cloned().unwrap_or_default();
                    obj.insert("integrity".into(), json!(status));
                    obj.insert("integrity_detail".into(), json!(detail));
                    Value::Object(obj)
                })
                .collect();
            json!({
                "models": enriched,
                "stats": {
                    "total": enriched.len(),
                    "source": "model_manifest.json",
                },
            })
        }
        None => json!({
            "models": [],
            "stats": { "total": 0, "source": "model_manifest.json (not found)" },
        }),
    }
}

fn model_detail(name: &str) -> Value {
    let Some(v) = load_manifest() else {
        return json!({ "error": "manifest not found" });
    };
    let Some(list) = v.get("models").and_then(|m| m.as_array()) else {
        return json!({ "error": "manifest malformed" });
    };
    for m in list {
        if m.get("model").and_then(|x| x.as_str()) == Some(name) {
            let bundle = m.get("bundle").and_then(|b| b.as_str()).unwrap_or("");
            let (status, detail) = verify_bundle(bundle);
            let mut obj = m.as_object().cloned().unwrap_or_default();
            obj.insert("integrity".into(), json!(status));
            obj.insert("integrity_detail".into(), json!(detail));
            return Value::Object(obj);
        }
    }
    json!({ "error": format!("no ingested model named '{name}'") })
}

fn ok_response(value: Value) -> Response<std::io::Cursor<Vec<u8>>> {
    let body = serde_json::to_string(&value).unwrap_or_else(|_| "{}".into());
    Response::from_string(body)
        .with_header(Header::from_bytes(&b"Content-Type"[..], &b"application/json"[..]).unwrap())
        .with_header(Header::from_bytes(&b"Access-Control-Allow-Origin"[..], &b"*"[..]).unwrap())
}

/// Dispatch /models* requests. Returns Some(response) if handled.
///
///   GET  /models                -> registry listing (integrity re-verified)
///   GET  /models/{name}         -> one model, integrity re-checked
///   POST /models/{name}/infer   -> run a tensor through the ternary tier
///                                  (CRC-gated; labeled approximate)
pub fn handle(request: &mut Request, url: &str) -> Option<Response<std::io::Cursor<Vec<u8>>>> {
    let method = request.method().clone();

    if method == Method::Get {
        if url == "/models" || url == "/models/" {
            return Some(ok_response(models_payload()));
        }
        if let Some(rest) = url.strip_prefix("/models/") {
            if let Some(name) = rest
                .strip_suffix("/selfcheck")
                .or_else(|| rest.strip_suffix("/selfcheck/"))
            {
                if !name.is_empty() {
                    return Some(match crate::ternary_engine::model_selfcheck(name) {
                        Ok(v) => ok_response(v),
                        Err(e) => ok_response(json!({ "error": e, "model": name, "executed": false })),
                    });
                }
            }
            let name = rest.trim_end_matches('/');
            if !name.is_empty() {
                return Some(ok_response(model_detail(name)));
            }
        }
        return None;
    }

    if method == Method::Post {
        // POST /models/{name}/infer  with body { tensor, input: [f32...] }
        if let Some(rest) = url.strip_prefix("/models/") {
            if let Some(name) = rest
                .strip_suffix("/infer")
                .or_else(|| rest.strip_suffix("/infer/"))
            {
                if name.is_empty() {
                    return None;
                }
                let body = read_body(request);
                let tensor = body.get("tensor").and_then(|t| t.as_str()).unwrap_or("");
                let input: Vec<f32> = body
                    .get("input")
                    .and_then(|i| i.as_array())
                    .map(|a| {
                        a.iter()
                            .filter_map(|v| v.as_f64())
                            .map(|v| v as f32)
                            .collect()
                    })
                    .unwrap_or_default();

                let result = if tensor.is_empty() {
                    Err(
                        "body must include {\"tensor\": \"<tensor name>\", \"input\": [floats]}"
                            .to_string(),
                    )
                } else if input.is_empty() {
                    Err("body must include a non-empty \"input\" array".to_string())
                } else {
                    crate::ternary_engine::infer_layer(name, tensor, &input)
                };

                return Some(match result {
                    Ok(v) => ok_response(v),
                    Err(e) => ok_response(json!({
                        "error": e,
                        "model": name,
                        "tensor": tensor,
                        "executed": false,
                    })),
                });
            }
        }

        // POST /models/{name}/forward  with body { tokens: [ids] } -> next-token logits
        if let Some(rest) = url.strip_prefix("/models/") {
            if let Some(name) = rest
                .strip_suffix("/forward")
                .or_else(|| rest.strip_suffix("/forward/"))
            {
                if !name.is_empty() {
                    let body = read_body(request);
                    let tokens: Vec<u32> = body
                        .get("tokens")
                        .and_then(|t| t.as_array())
                        .map(|a| a.iter().filter_map(|v| v.as_u64()).map(|v| v as u32).collect())
                        .unwrap_or_default();
                    let result = crate::mamba_forward::Mamba::load(name)
                        .and_then(|m| m.forward(&tokens));
                    return Some(match result {
                        Ok(logits) => ok_response(json!({
                            "model": name,
                            "logits_len": logits.len(),
                            "argmax_token": argmax(&logits),
                            "top5": top5(&logits),
                            "approximate": true,
                            "engine": "mamba_ssm_ternary",
                            "notice": "APPROXIMATE ternary forward pass",
                        })),
                        Err(e) => ok_response(json!({"error": e, "model": name, "executed": false})),
                    });
                }
            }
        }
    }
    None
}

fn argmax(v: &[f32]) -> usize {
    let mut best = 0usize;
    for (i, &x) in v.iter().enumerate().skip(1) {
        if x > v[best] {
            best = i;
        }
    }
    best
}

fn top5(v: &[f32]) -> Vec<Value> {
    let mut idx: Vec<usize> = (0..v.len()).collect();
    idx.sort_by(|&a, &b| v[b].partial_cmp(&v[a]).unwrap_or(std::cmp::Ordering::Equal));
    idx.into_iter().take(5).map(|i| json!({ "token": i, "logit": (v[i] as f64 * 1e6).round() / 1e6 })).collect()
}

/// Read a POST body as JSON (up to 1 MB).
fn read_body(request: &mut Request) -> Value {
    use std::io::Read;
    let mut buf = Vec::new();
    let mut limited = request.as_reader().take(1_048_576);
    let _ = limited.read_to_end(&mut buf);
    serde_json::from_slice(&buf).unwrap_or(json!({}))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn crc32_matches_zlib_known_vectors() {
        // Canonical CRC-32 (IEEE) test vectors.
        assert_eq!(crc32(b""), 0x0000_0000);
        assert_eq!(crc32(b"a"), 0xE8B7_BE43);
        assert_eq!(crc32(b"abc"), 0x3524_41C2);
        assert_eq!(crc32(b"123456789"), 0xCBF4_3926);
    }

    #[test]
    fn header_crc_round_trips() {
        let mut header = vec![0u8; HEADER_SIZE];
        header[0..8].copy_from_slice(&MMAP_MAGIC.to_le_bytes());
        header[8..12].copy_from_slice(&MMAP_VERSION.to_le_bytes());
        header[12..16].copy_from_slice(&7u32.to_le_bytes()); // index
        header[24..28].copy_from_slice(&3u32.to_le_bytes()); // restart_count
        let c = crc32(&header[..CRC_PAYLOAD_LEN]);
        header[CRC_OFFSET..CRC_OFFSET + 4].copy_from_slice(&c.to_le_bytes());

        let stored = u32::from_le_bytes(header[CRC_OFFSET..CRC_OFFSET + 4].try_into().unwrap());
        assert_eq!(stored, crc32(&header[..CRC_PAYLOAD_LEN]));

        // corrupting a payload byte must break the check
        let mut bad = header.clone();
        bad[12] ^= 0xFF;
        assert_ne!(stored, crc32(&bad[..CRC_PAYLOAD_LEN]));
    }

    #[test]
    fn missing_bundle_reports_missing_not_corrupt() {
        let (status, _detail) = verify_bundle("definitely-not-a-real-bundle.trm");
        assert_eq!(status, "missing");
    }
}
