# Generated by Archi (Architect)
# Use an official Python runtime as a parent image
FROM python:3.10-slim-buster

# Set the working directory in the container
WORKDIR /app

# Install any needed packages specified in requirements.txt
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy the current directory contents into the container at /app
COPY . .

# Expose port 8000 for the Uvicorn server
EXPOSE 8000

# Run the Uvicorn server with Gunicorn for production-grade concurrency
# Using --workers 4 (or based on CPU cores) for better performance
# Using --bind 0.0.0.0:8000 to listen on all interfaces
# Using --worker-class uvicorn.workers.UvicornWorker for async support
CMD ["gunicorn", "app.main:app", "--workers", "4", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000"]