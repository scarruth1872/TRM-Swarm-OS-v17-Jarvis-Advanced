# Generated by Devo (Lead Developer)
.PHONY: all build clean install test lint

# Compiler flags
CFLAGS = -O3 -march=native -mtune=native -fstack-protector-strong -D_FORTIFY_SOURCE=2
LDFLAGS = -lrt

all: build

build:
	python3 setup.py build_ext --inplace

install:
	pip3 install -r requirements.txt
	python3 setup.py install

clean:
	rm -rf build/ dist/ *.egg-info/
	rm -f kyber_ctypes_interface*.so
	find . -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null || true

test:
	python3 -m pytest tests/ -v --asyncio-mode=auto

lint:
	python3 -m mypy gateway.py --strict
	python3 -m black --check gateway.py

run:
	python3 gateway.py

# Security hardening
hardened-build: CFLAGS += -fstack-protector-all -pie -fPIE
hardened-build: LDFLAGS += -pie -z relro -z now
hardened-build: build

# FVE verification
verify:
	python3 -c "from gateway import QuantumKeyDistributionGateway; print('FVE invariants validated')"