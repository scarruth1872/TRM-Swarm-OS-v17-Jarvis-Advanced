{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress", "dashboard", "json"],
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "testRunner": "jest",
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 75
  },
  "mutate": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.spec.ts"
  ],
  "ignorePatterns": [
    "node_modules",
    "dist",
    "coverage",
    "reports"
  ],
  "timeoutMs": 10000,
  "concurrency": 4,
  "tempDirName": ".stryker-tmp",
  "htmlReporter": {
    "baseDir": "reports/mutation/html"
  },
  "jest": {
    "configFile": "jest.config.js"
  }
}