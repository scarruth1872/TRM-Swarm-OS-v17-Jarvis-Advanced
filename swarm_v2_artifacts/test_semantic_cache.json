@pytest.fixture
def sample_cache_data() -> Dict[str, Any]:
    """Load the actual semantic_cache.json for realistic test data."""
    cache_path = Path("semantic_cache.json")
    if not cache_path.exists():
        pytest.skip("semantic_cache.json not found in current directory")
    with open(cache_path, "r") as f:
        return json.load(f)


@pytest.fixture
def valid_entry_template() -> Dict[str, Any]:
    """Return a template for a valid cache entry."""
    return {
        "key": "test_key_123",
        "query_hash": "abc123def456",
        "query": "What is the capital of France?",
        "response": {
            "content": "Paris",
            "thought": "Simple geography question"
        },
        "created_at": time.time(),
        "hit_count": 0,
        "last_hit_at": None,
        "metadata": {}
    }


@pytest.fixture
def populated_cache(valid_entry_template) -> Dict[str, Any]:
    """Create a cache dict with multiple entries for lookup tests."""
    entries = {}
    for i in range(5):
        entry = deepcopy(valid_entry_template)
        entry["key"] = f"key_{i}"
        entry["query_hash"] = hashlib.sha256(f"query_{i}".encode()).hexdigest()[:16]
