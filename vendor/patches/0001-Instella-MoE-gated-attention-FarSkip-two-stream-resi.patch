new file mode 100644
index 0000000..358dc18
--- /dev/null
+++ b/conversion/instella.py
@@ -0,0 +1,48 @@
+from __future__ import annotations
+
+import gguf
+
+from .base import ModelBase
+from .deepseek import DeepseekV2Model
+
+
+@ModelBase.register("InstellaMoEForCausalLM")
+class InstellaMoEModel(DeepseekV2Model):
+    """AMD Instella MoE: a DeepSeek-V3 backbone with two additional mechanisms.
+
+      1. MLAGatedAttention  - attn_output *= sigmoid(gate_proj(x)), applied BEFORE o_proj.
+                              gate_proj maps to blk.{bid}.attn_gate, which llama.cpp's
+                              DeepSeek-V3 graph has no slot for by default.
+      2. FarSkip-Collective - the decoder carries TWO residual streams: the full one and a
+                              routed-free one (post-attention residual + shared expert only).
+                              Attention of the next layer reads the routed-free stream.
+
+    Both are recorded in the GGUF so the runtime cannot silently ignore them: dropping either
+    would load and run happily while computing a different network.
+    """
+
+    model_arch = gguf.MODEL_ARCH.DEEPSEEK2
+
+    def set_gguf_parameters(self):
+        hp = self.hparams
+
+        # fail closed on the variants this implementation does not express
+        if hp.get("attn_only_farskip", False) or hp.get("mlp_only_farskip", False):
+            raise NotImplementedError(
+                "Instella MoE: attn_only_farskip / mlp_only_farskip are not implemented; "
+                "refusing to write a GGUF whose graph would differ from the source model"
+            )
+
+        super().set_gguf_parameters()
+
+        n_layer = int(hp["num_hidden_layers"])
+        self.gguf_writer.add_gated_attention(bool(hp.get("gated_attention", False)))
+
+        farskip = bool(hp.get("farskip", False))
+        self.gguf_writer.add_far_skip(farskip)
+
+        start = int(hp.get("farskip_start_idx", 0) or 0)
+        end_raw = hp.get("farskip_end_idx", n_layer - 1)
+        end = min(int(end_raw if end_raw is not None else n_layer - 1), n_layer - 1)
+        self.gguf_writer.add_far_skip_start_idx(start)
+        self.gguf_writer.add_far_skip_end_idx(end)
diff --git a/docs/instella-farskip.md b/docs/instella-farskip.md
new file mode 100644
index 0000000..4fab432
--- /dev/null
+++ b/docs/instella-farskip.md
@@ -0,0 +1,65 @@
+# Instella MoE (FarSkip-Collective) support in llama.cpp
+
+`InstellaMoEForCausalLM` (AMD Instella MoE Think, 16B total / ~3B active) is a DeepSeek-V3
+backbone with **two mechanisms that stock llama.cpp does not express**. Both are now implemented
+in the `deepseek2` arch behind GGUF keys that default to off, so existing DeepSeek-V2/V3 GGUFs
+behave exactly as before.
+
+## 1. MLAGatedAttention
+
+```python
+attn_output = attention(...)                 # reshaped to (b, s, n_head * v_head_dim)
+attn_output = attn_output * sigmoid(gate_proj(hidden_states))   # hidden_states = the NORMED input
+attn_output = o_proj(attn_output)
+```
+
+Weight: `blk.{i}.attn_gate.weight`, shape `{n_embd, n_head * v_head_dim}` (2048 x 2048 here).
+Mapped already by `MODEL_TENSOR.ATTN_GATE` (`model.layers.{bid}.self_attn.gate_proj`).
+
+Graph: `build_attn` is called with `wo = nullptr` so the projection is **not** applied inside the
+attention, then `cur = cur * sigmoid(attn_gate @ attn_normed)`, then `build_lora_mm(wo, cur)`.
+
+## 2. FarSkip-Collective
+
+The decoder carries **two residual streams**:
+
+```
+r             = h_full_prev + attn(with input read from h_norouted_prev)
+h_norouted    = r + shared_expert_output        # routed-free
+h_full        = r + routed_output + shared      # numerically identical to stock DeepSeek-V3
+```
+
+`FarSkipMoE.forward` returns `(routed + shared, shared)` precisely so the caller can build the
+routed-free stream. Attention of the next layer reads `h_norouted`; the residual base is `h_full`.
+
+A **dense** layer returns a single tensor in HF (not a tuple), so the two-stream state starts only
+at the first MoE layer — the implementation resets the second stream to `nullptr` on dense layers
+and only reads it when it is non-null, mirroring HF's `isinstance(hidden_states, tuple)` test.
+
+`attn_only_farskip` / `mlp_only_farskip` are **not** implemented; the converter raises
+`NotImplementedError` rather than writing a GGUF whose graph would differ from the source model.
+
+## GGUF keys (all optional, default off)
+
+| key | type | meaning |
+|---|---|---|
+| `deepseek2.gated_attention` | bool | apply the attention output gate |
+| `deepseek2.far_skip` | bool | two-stream residual active |
+| `deepseek2.far_skip_start_idx` | u32 | first layer with the two-stream residual |
+| `deepseek2.far_skip_end_idx` | u32 | last such layer |
+
+Converter: `conversion/instella.py` (`InstellaMoEModel`, subclass of `DeepseekV2Model`).
+
+## Measured
+
+`F:\models\instella-moe-think` (6 safetensors, 31.7 GB bf16, 5,344 tensors) converts to a
+q8_0 GGUF of 457 tensors / 16.9 GB. Loads and generates coherent text:
+
+```
+prompt: "The capital of France is"
+output: " thinking\nOkay, the user is asking about the capital of France. Let me make sure"
+```
+
+Without these two mechanisms the same weights produce a model that loads and disagrees with the
+source — not a crash, which is why a structural tensor/flag check was required rather than a
+smoke test.
